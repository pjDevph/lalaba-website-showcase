# Base URL of the LALABA_BE_DEV backend, no trailing slash. Used server-side
# only (lib/site-content.ts) to read the admin panel's CMS content — FAQ,
# service areas, promo banners. Never sent to the browser (not NEXT_PUBLIC_).
#
# If unset, the site falls back to the static content/*.ts files unchanged —
# safe to leave unset in an environment that hasn't been wired up yet.
LALABA_API_BASE_URL=http://localhost:3001
